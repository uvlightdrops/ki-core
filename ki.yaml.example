# ki-core Configuration (generic, app-agnostic base)
#
# Schema-based config generation with layered resolution:
# 1. Environment variables (KI_CFG_* prefix)
# 2. Runtime files (config/runtime/runtime.yaml)
# 3. Stages (config/stages/*.yaml)
# 4. Profiles (config/profiles/*.yaml)
# 5. Defaults (config/defaults/*.yaml)
# 6. Main config (ki.yaml)
# 7. Schema defaults (declared in schema/*.schema.yaml)
#
# Credentials (api_key, base_url) should go in creds.yaml for security.
# This file contains non-sensitive defaults and application settings.
#
# ki-core's own schema only covers the sections below (llm, http, creds).
# Each app (kicli-code-assist, ki-knowledge, ...) provides its own
# ki.yaml.example with the sections it owns (see that app's repo).

# LLM Provider Configuration
llm:
  default_provider: "ki"  # Options: ki, openai, ollama
  providers:
    # Company KI Server
    ki:
      base_url: "https://api.example.com/v1"    # Set in creds.yaml
      api_key: ""                                 # Set in creds.yaml
      model: "google/gemma-4-26B-A4B-it"
      endpoint: ""  # Optional: explicit endpoint path

    # Ollama (local inference)
    ollama:
      base_url: "http://localhost:11434"
      model: "llama3.2"

    # OpenAI or compatible
    openai:
      base_url: "https://api.openai.com/v1"
      model: "gpt-4"
      api_key: ""  # Set in creds.yaml

# HTTP client settings
http:
  request_timeout: 30
  verify_ssl: true

# Application-specific settings live under `apps.<app_name>.*` and are
# defined by each app's own schema, merged on top of this base schema
# at runtime (see schema/*.schema.yaml in each app's repo), e.g.:
#
# apps:
#   kicli:
#     workspace_root: ""
#     ...  # see kicli-code-assist/ki.yaml.example
#   ki_knowledge:
#     api_url: ""
#     ...  # see ki-knowledge/ki.yaml.example
