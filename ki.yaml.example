# Unified configuration for the ki ecosystem
# Shared by: ki-core, ki-knowledge, kicli-code-assist
# 
# Credentials (api_key, base_url) should go in creds.yaml for security
# This file contains non-sensitive configuration

# LLM Provider: Company KI Server
ki:
  base_url: ""      # Set in creds.yaml
  api_key: ""       # Set in creds.yaml
  model: "google/gemma-4-26B-A4B-it"
  endpoint: ""      # Optional: explicit endpoint path

# LLM Provider: Ollama (local inference)
ollama:
  base_url: "http://localhost:11434"
  model: "llama3.2"

# LLM Provider: OpenAI (or compatible)
openai:
  base_url: "https://api.openai.com/v1"
  model: "gpt-4"
  api_key: ""       # Set in creds.yaml

# Knowledge base settings
knowledge:
  data_root: ""                    # e.g., ~/dev_data/kicli
  cache_db: ""                     # Optional: custom cache location
  graph_db: ""                     # Optional: custom graph db location
  embed_model: "nomic-embed-text"  # Model for embeddings

# JIRA integration (optional, for legacy workflows)
jira:
  url: ""
  username: ""
  api_token: ""    # Set in creds.yaml

# HTTP client settings
http:
  request_timeout: 30
  verify_ssl: true

# KI CLI / Code Assistant (kicli-code-assist)
kicli:
  cache_dir: "~/dev_data/kicli-code-assist"
  session_dir: "~/dev_data/kicli-code-assist/sessions"
  chat_history_dir: "~/dev_data/kicli-code-assist/chat_history"

# Context System (Phase 2: Intelligent Context)
context:
  max_files: 10                    # Maximum number of files to include in context
  max_size_mb: 5                   # Maximum total context size in MB
  relevance_threshold: 0.15        # Minimum relevance score (0-1, lower=more inclusive)
  cache_enabled: true              # Enable context caching
  cache_ttl_hours: 24              # Cache time-to-live in hours
  cache_max_size_mb: 50            # Maximum cache size in MB
  ignore_patterns: "__pycache__,*.pyc,node_modules,.git,.env"  # Patterns to ignore

# Diff Engine (Phase 3: Diff & Change Management)
diff:
  context_lines: 3                 # Number of context lines in diffs
  format: "unified"                # Diff format: unified, side-by-side, inline
  highlight_syntax: true           # Syntax highlighting in diff viewer
  auto_apply_threshold: 0.8        # Confidence threshold for auto-applying changes
  max_file_size_kb: 100            # Maximum file size to diff
